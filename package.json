{
  "name": "dsh-code-editor",
  "version": "1.0.7",
  "description": "Browse, search, edit, and save project files with syntax highlighting, and insert selected code into the message draft.",
  "license": "MIT",
  "author": "ChriFang",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChriFang/dsh-code-editor.git"
  },
  "homepage": "https://github.com/ChriFang/dsh-code-editor#readme",
  "bugs": {
    "url": "https://github.com/ChriFang/dsh-code-editor/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "code-editor",
    "syntax-highlighting"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
